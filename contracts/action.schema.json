{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/luxleader/GUI-Agent/contracts/action/1.0",
  "definitions": {
    "coordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "$ref": "#/definitions/coordinate" }, "y": { "$ref": "#/definitions/coordinate" } }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["type", "x", "y"],
      "properties": { "type": { "const": "tap" }, "x": { "$ref": "#/definitions/coordinate" }, "y": { "$ref": "#/definitions/coordinate" } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "from", "to", "durationMs"],
      "properties": { "type": { "const": "swipe" }, "from": { "$ref": "#/definitions/point" }, "to": { "$ref": "#/definitions/point" }, "durationMs": { "type": "integer", "minimum": 1, "maximum": 10000 } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "text"],
      "properties": { "type": { "const": "type" }, "text": { "type": "string", "maxLength": 10000 } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "ms"],
      "properties": { "type": { "const": "wait" }, "ms": { "type": "integer", "minimum": 0, "maximum": 30000 } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "enum": ["back", "home", "finish"] } }
    }
  ]
}
